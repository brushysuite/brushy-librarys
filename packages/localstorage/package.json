{
  "name": "@brushy/localstorage",
  "version": "1.0.2",
  "description": "Deprecated. Use @brushy/storage and @brushy/storage-react instead",
  "deprecated": "Use @brushy/storage. See https://github.com/brushysuite/brushy-librarys/tree/main/packages/storage",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "authors": [
    {
      "name": "Gustavo Franco",
      "email": "contact@gfrancodev.com",
      "url": "https://github.com/gfrancodev"
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "localstorage",
    "storage",
    "browser",
    "typescript",
    "compression",
    "ttl"
  ],
  "author": "Gustavo Franco <contact@gfrancodev.com>",
  "license": "MIT",
  "homepage": "https://gfrancodev.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brushysuite/brushy-librarys.git",
    "directory": "packages/localstorage"
  },
  "bugs": {
    "url": "https://github.com/brushysuite/brushy-librarys/issues"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/node-localstorage": "^1.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@swc/core": "^1.16.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.0.1",
    "node-localstorage": "^3.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  }
}
