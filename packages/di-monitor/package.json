{
  "name": "@brushy/di-monitor",
  "version": "2.0.0",
  "description": "Container monitoring utilities for @brushy/di-core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "react-native": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo node_modules",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "monitoring",
    "observability"
  ],
  "author": "Gustavo Franco <contact@gfrancodev.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brushysuite/brushy-librarys.git",
    "directory": "packages/di-monitor"
  },
  "homepage": "https://brushysuite.gfrancodev.com/docs/di",
  "dependencies": {
    "@brushy/di-core": "*"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/node": "^22.20.2",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
