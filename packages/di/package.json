{
  "name": "@brushy/di",
  "version": "2.0.0",
  "description": "Brushy DI v2 umbrella: core, React hooks, monitor, and optional otel subpaths",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "authors": [
    {
      "name": "Gustavo Franco",
      "email": "contact@gfrancodev.com",
      "url": "https://github.com/gfrancodev"
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./monitor": {
      "types": "./dist/monitor.d.ts",
      "import": "./dist/monitor.mjs",
      "require": "./dist/monitor.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.mjs",
      "require": "./dist/otel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "react-native": "./dist/react.mjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "check-types": "tsc --noEmit",
    "docs": "serve docs",
    "docs:api": "typedoc --options typedoc.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "typescript",
    "react"
  ],
  "author": "Gustavo Franco <contact@gfrancodev.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brushysuite/brushy-librarys.git",
    "directory": "packages/di"
  },
  "bugs": {
    "url": "https://github.com/brushysuite/brushy-librarys/issues"
  },
  "homepage": "https://brushysuite.gfrancodev.com/docs/di",
  "dependencies": {
    "@brushy/di-core": "*",
    "@brushy/di-react": "*",
    "@brushy/di-monitor": "*",
    "@brushy/di-otel": "*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@brushy/di-core": "*",
    "@brushy/di-react": "*",
    "@brushy/di-monitor": "*",
    "@brushy/di-otel": "*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@swc/core": "^1.16.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serve": "^14.2.6",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
